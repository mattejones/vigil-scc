# Server
PORT=3000
MCP_PORT=3001
NODE_ENV=development

# Database
DB_PATH=./data/vigil.db

# Approval timeout in milliseconds (default: 5 minutes)
APPROVAL_TIMEOUT_MS=300000

# TLS — optional, enables HTTPS on the MCP server
# Generate with: mkcert -key-file ./certs/localhost-key.pem -cert-file ./certs/localhost.pem localhost 127.0.0.1

# ─── Command execution ────────────────────────────────────────────────────────

# Fallback per-command timeout in ms. 0 = no timeout (default); commands run until
# they finish or are stopped. Suggested if you want a safety net: 600000 (10 min).
# The AI can also set timeout_seconds per command.
CMD_TIMEOUT_MS=0

# Grace period between SIGINT → SIGTERM → SIGKILL when stopping a command.
INTERRUPT_GRACE_MS=5000

# Idle time with no output before checking whether a command is waiting for input.
INPUT_IDLE_MS=3000

# Maximum output kept per command (tail). Default 2MB.
OUTPUT_MAX_BYTES=2097152

# Where tracked runs live on the remote host ($HOME expands remotely).
# Falls back to ${TMPDIR:-/tmp}/vigil-runs if this can't be created.
VIGIL_REMOTE_DIR=$HOME/.vigil/runs

# How long to keep retrying to reattach to a run after a restart or dropped connection.
RECOVERY_TIMEOUT_MS=300000

# SSH keepalive — detects dead connections instead of hanging.
SSH_KEEPALIVE_INTERVAL_MS=15000
SSH_KEEPALIVE_COUNT_MAX=4
SSH_READY_TIMEOUT_MS=20000
